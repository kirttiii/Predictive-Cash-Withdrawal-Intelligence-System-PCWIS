# === Cybercrime Framework Environment Variables ===
# Copy this file to .env and fill in real values.

# Redis (for streaming producers, optional for SQLite-only mode)
REDIS_HOST=localhost
REDIS_PORT=6379

# Neo4j (optional, not used by active pipeline)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=your_neo4j_password

# PostGIS (spatial candidate generation)
POSTGIS_HOST=localhost
POSTGIS_PORT=5432
POSTGIS_DB=cybercrime_gis
POSTGIS_USER=postgres
POSTGIS_PASS=your_postgis_password

# Security
HMAC_SECRET_KEY=generate_a_64_char_hex_key_here
JWT_SECRET=generate_a_64_char_hex_key_here

# Google reCAPTCHA (frontend)
RECAPTCHA_SECRET_KEY=YOUR_SECRET_KEY
